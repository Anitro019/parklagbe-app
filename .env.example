# ==============================================================================
# ParkLagbee Environment Configuration Template
# Copy this file to .env and fill in your real credentials
# ==============================================================================

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-actual-anon-key


# Do NOT put SMTP / Gmail App Password values here: everything in this file is
# compiled into the app via --dart-define-from-file=.env.
# Gmail SMTP lives in .env.smtp and is applied to Supabase with:
#   py tool/configure_supabase_email.py
#
# .env.smtp template:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_EMAIL=your-email@gmail.com
#   SMTP_PASSWORD=your-16-character-app-password
#   SMTP_SENDER_NAME=ParkLagbee Support
