# ==============================================================================
# ParkLagbee Environment Configuration Template
# Copy this file to .env and fill in your real credentials
# ==============================================================================

# Supabase Credentials
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-actual-anon-key

# Do not add SMTP credentials or ADMIN_EMAIL here. This file may be passed to
# Flutter at build time and is bundled into the application.
#
# Support-report SMTP values belong in the private, git-ignored .env.smtp file
# and must be configured as Supabase Edge Function secrets. See
# TECHNICAL_DOCUMENTATION.md.
#
# .env.smtp template:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_EMAIL=your-email@gmail.com
#   SMTP_PASSWORD=your-16-character-app-password
#   ADMIN_EMAIL=your-support-email@gmail.com
#   SMTP_SENDER_NAME=ParkLagbee Support
